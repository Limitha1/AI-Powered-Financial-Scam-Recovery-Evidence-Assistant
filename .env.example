# ==============================================================================
# ShieldTrace AI - Root Environment Reference
# Copy the relevant configurations into server/.env and client/.env:
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API Key (Required for AI Forensics & Structured Dossier Synthesis)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Admin / Service Role (Optional - falls back to resilient local store)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Authentication Secret
JWT_SECRET=shieldtrace-jwt-production-secret-2026

# ------------------------------------------------------------------------------
# CLIENT (client/.env)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
