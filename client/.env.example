# ==============================================================================
# ShieldTrace AI - Client Environment Configuration
# Duplicate this file as '.env' inside the 'client' directory:
#   cp .env.example .env
# ==============================================================================

# Backend API Endpoint Base URL (Optional: defaults to '/api' when using Vite dev proxy or Vercel)
# Uncomment or set if running frontend and backend on distinct ports/origins without proxy:
# VITE_API_BASE_URL=http://localhost:5000/api

# Supabase Client Configuration (Optional - matches backend Supabase instance)
# Obtain from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
